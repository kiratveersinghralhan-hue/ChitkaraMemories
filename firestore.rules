rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules → Publish.
//
//  • Only @chitkara.edu.in Google accounts can even sign in.
//  • On top of that, a person must be APPROVED to see anything:
//      - an admin, or
//      - their email ends in AUTO_APPROVE (leave '' to require approval for everyone), or
//      - their email was pre-approved by an admin (/allowlist), or
//      - they requested access and an admin approved it (/members).
//  • Banned users can't read or write anything.
//  • Every login, upload, download, like, comment, report and delete goes into /activity (admins only).
//
// Keep the admin emails, AUTO_APPROVE and the capsule unlock date (2029, 5, 1) in sync with js/config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && email() in [
          'kiratveersinghralhan@gmail.com',
          'kiratveer4791.bbadsbm26@chitkara.edu.in'
        ];
    }
    // AUTO_APPROVE: '' = everyone needs approval (default).
    // To let your whole batch in automatically, change it to:  '.*[.]bbadsbm26@chitkara[.]edu[.]in$'
    // and set AUTO_APPROVE_SUFFIX = ".bbadsbm26@chitkara.edu.in" in js/config.js.
    function autoApproveRegex() {
      return '';
    }
    function isMember() {
      return signedIn()
        && request.auth.token.email_verified == true
        && (email().matches('.*@chitkara[.]edu[.]in$') || isAdmin());
    }
    function notBanned() {
      return !exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }
    function approved() {
      return isAdmin()
        || (autoApproveRegex() != '' && email().matches(autoApproveRegex()))
        || exists(/databases/$(database)/documents/allowlist/$(email()))
        || (exists(/databases/$(database)/documents/members/$(request.auth.uid))
            && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'approved');
    }
    function isActive() {
      return isMember() && notBanned() && approved();
    }
    function str(v, max) {
      return v is string && v.size() <= max;
    }

    // ── photos ──
    match /memories/{memoryId} {
      allow read: if isActive();

      allow create: if isActive()
        && request.resource.data.keys().hasOnly([
             'url', 'thumb', 'w', 'h', 'caption', 'year', 'event', 'album', 'people', 'peopleUids',
             'uploaderUid', 'uploaderName', 'uploaderEmail', 'uploaderPhoto', 'likedBy', 'createdAt'])
        && request.resource.data.uploaderUid == request.auth.uid
        && request.resource.data.uploaderEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.likedBy == []
        && str(request.resource.data.url, 500)
        && str(request.resource.data.thumb, 120000)
        && str(request.resource.data.caption, 120)
        && str(request.resource.data.event, 40)
        && str(request.resource.data.get('album', ''), 40)
        && request.resource.data.year in ['y1', 'y2', 'y3', 'fw']
        && request.resource.data.people is list && request.resource.data.people.size() <= 20
        && request.resource.data.get('peopleUids', []) is list && request.resource.data.get('peopleUids', []).size() <= 20
        && str(request.resource.data.uploaderName, 60);

      // Hearts (only your own uid) and emoji reactions (only your own entry).
      allow update: if isActive() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
          && (
            (!(request.auth.uid in resource.data.likedBy)
              && request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid]))
            ||
            ((request.auth.uid in resource.data.likedBy)
              && request.resource.data.likedBy == resource.data.likedBy.removeAll([request.auth.uid]))
          )
        )
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions)
              || request.resource.data.reactions[request.auth.uid] in ['😂', '🔥', '💀', '🥹', '😍', '👏'])
        )
      );

      allow delete: if isAdmin() || (isActive() && resource.data.uploaderUid == request.auth.uid);

      // comments
      match /comments/{commentId} {
        allow read: if isActive();
        allow create: if isActive()
          && request.resource.data.keys().hasOnly(['text', 'uid', 'name', 'photo', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
          && str(request.resource.data.name, 80);
        allow delete: if isAdmin() || (isActive() && resource.data.uid == request.auth.uid);
      }
    }

    // Full-size photos (used when Cloudinary isn't configured).
    match /memoryFull/{memoryId} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['data', 'uploaderUid'])
        && request.resource.data.uploaderUid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow delete: if isAdmin() || (isActive() && resource.data.uploaderUid == request.auth.uid);
    }

    // ── access requests ──
    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // a new person may create or refresh their OWN pending request (never approve themselves)
      allow create, update: if isMember() && notBanned() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['status', 'email', 'name', 'photo', 'note', 'requestedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.requestedAt == request.time
        && str(request.resource.data.note, 200)
        && (resource == null || resource.data.status == 'pending' || resource.data.status == 'none');
      allow update, delete: if isAdmin();
    }

    // emails an admin pre-approved (document id = lowercase email)
    match /allowlist/{addr} {
      allow get: if isAdmin() || (signedIn() && email() == addr);
      allow list, write: if isAdmin();
    }

    // ── public yearbook profiles ──
    match /profiles/{uid} {
      allow read: if isActive();
      allow create, update: if isActive() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photo', 'nickname', 'quote', 'mostLikely', 'insta', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && str(request.resource.data.name, 80)
        && str(request.resource.data.nickname, 40)
        && str(request.resource.data.quote, 200)
        && str(request.resource.data.mostLikely, 100)
        && str(request.resource.data.insta, 40);
      allow delete: if isAdmin();
    }

    // ── time capsule: sealed until unlock day ──
    match /capsules/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid)
        || (isAdmin() && resource.data.visibility == 'batch')
        || (isActive() && resource.data.visibility == 'batch' && request.time >= timestamp.date(2029, 5, 1));
      allow create, update: if isActive() && request.auth.uid == uid
        && request.time < timestamp.date(2029, 5, 1)
        && request.resource.data.keys().hasOnly(['text', 'visibility', 'name', 'photo', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.visibility in ['private', 'batch']
        && str(request.resource.data.text, 3000);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // ── private user records (for the admin panel) ──
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isActive() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'photo', 'device', 'firstSeen', 'lastSeen', 'logins'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.firstSeen == request.time
        && request.resource.data.lastSeen == request.time
        && request.resource.data.logins == 1;
      allow update: if isActive() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo', 'device', 'lastSeen', 'logins'])
        && request.resource.data.lastSeen == request.time
        && (request.resource.data.logins == resource.data.logins
            || request.resource.data.logins == resource.data.logins + 1);
      allow delete: if isAdmin();
    }

    // ── activity log: write-only for students, read-only for admins ──
    match /activity/{id} {
      allow create: if isActive()
        && request.resource.data.keys().hasOnly([
             'type', 'uid', 'email', 'name', 'device', 'memoryId', 'memoryCaption',
             'ownerUid', 'ownerName', 'detail', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.at == request.time
        && request.resource.data.type in ['login', 'upload', 'download', 'like', 'unlike', 'delete', 'report',
             'comment', 'profile', 'capsule', 'ban', 'unban', 'approve', 'deny', 'allow']
        && str(request.resource.data.detail, 200);
      allow read, delete: if isAdmin();
    }

    // ── reports from students ──
    match /reports/{id} {
      allow create: if isActive()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterEmail == request.auth.token.email
        && request.resource.data.at == request.time
        && str(request.resource.data.note, 300);
      allow read, delete: if isAdmin();
    }

    // ── banned users ──
    match /banned/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }
  }
}
